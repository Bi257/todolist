<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>MVC Todo App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .done-text { text-decoration: line-through; color: gray; }
        .stats-badge { font-size: 0.9rem; margin-right: 10px; }
    </style>
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-primary mb-4">
    <div class="container">
        <span class="navbar-brand">Quản lý công việc</span>
        <div class="text-white">
            Chào, <strong><%= currentUser.fullName %></strong> (<%= currentUser.role %>) | 
            <a href="/logout" class="btn btn-sm btn-danger">Đăng xuất</a>
        </div>
    </div>
</nav>

<div class="container">
    <div class="mb-4">
        <span class="badge bg-info stats-badge">Task hôm nay: <%= stats.today %></span>
        <span class="badge bg-warning text-dark stats-badge">Chưa xong: <%= stats.pending %></span>
        <span class="badge bg-secondary stats-badge">User họ Nguyễn: <%= stats.nguyenTasks %></span>
    </div>

    <div class="card p-4 shadow-sm mb-4">
        <form action="/tasks" method="POST" class="row g-3">
            <div class="col-md-6">
                <input type="text" name="title" class="form-control" placeholder="Tên công việc..." required>
            </div>
            <div class="col-md-4">
                <% if (currentUser.role === 'admin') { %>
                    <select name="assignId" class="form-select" multiple size="2">
                        <% users.forEach(u => { %>
                            <option value="<%= u._id %>"><%= u.fullName %></option>
                        <% }) %>
                    </select>
                    <small class="text-muted text-xs">Admin: Giữ Ctrl để giao nhiều người</small>
                <% } else { %>
                    <input type="text" class="form-control" value="Tự giao việc" disabled>
                <% } %>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">Thêm</button>
            </div>
        </form>
    </div>

    <div class="list-group shadow-sm">
        <% tasks.forEach(task => { %>
            <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div class="w-75">
                    <h5 class="<%= task.isDone ? 'done-text' : '' %> mb-1"><%= task.title %></h5>
                    <p class="mb-2 small">Người thực hiện: 
                        <span class="text-primary"><%= task.assignedTo.map(u => u.fullName).join(', ') %></span>
                    </p>

                    <% let percent = (task.completedBy.length / task.assignedTo.length) * 100 %>
                    <div class="progress" style="height: 10px; width: 300px;">
                        <div class="progress-bar <%= percent === 100 ? 'bg-success' : 'bg-info progress-bar-striped' %>" 
                             style="width: <%= percent %>%"></div>
                    </div>
                    <% if (task.isDone) { %>
                        <small class="text-success mt-1 d-block">Hoàn thành lúc: <%= task.doneAt.toLocaleString() %></small>
                    <% } %>
                </div>

                <div class="btn-group">
                    <% if (!task.completedBy.some(id => id._id.toString() === currentUser._id.toString())) { %>
                        <form action="/tasks/complete/<%= task._id %>" method="POST" class="me-2">
                            <button class="btn btn-outline-success btn-sm">Xong</button>
                        </form>
                    <% } %>
                    <a href="/tasks/delete/<%= task._id %>" class="btn btn-outline-danger btn-sm" onclick="return confirm('Xóa?')">Xóa</a>
                </div>
            </div>
        <% }) %>
    </div>
</div>
</body>
</html>